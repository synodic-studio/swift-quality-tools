#!/bin/bash

# Custom SwiftLint wrapper that includes SwiftSyntax rules
# Usage: ./swiftlint-custom [file.swift]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Run regular SwiftLint first
echo "Running SwiftLint..."
swiftlint "$@"

# Then run our custom SwiftSyntax rules
echo ""
echo "Running custom SwiftSyntax rules..."

if [ $# -eq 0 ]; then
    # No arguments - scan all Swift files
    find . -name "*.swift" -type f | while read -r file; do
        result=$("$SCRIPT_DIR/swiftlint-tests/test-swiftsyntax-rule.sh" "$file" 2>/dev/null | grep "⚠️")
        if [ -n "$result" ]; then
            echo "$file: $result"
        fi
    done
else
    # Specific file provided
    "$SCRIPT_DIR/swiftlint-tests/test-swiftsyntax-rule.sh" "$1"
fi